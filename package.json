{
    "name": "familie-ef-ettersending",
    "version": "0.5.0",
    "type": "module",
    "scripts": {
        "start": "node build/backend/server.js",
        "dev": "tsc -p tsconfig.backend.json && NODE_ENV=development node build/backend/server.js",
        "build": "NODE_ENV=production vite build && tsc -p tsconfig.backend.json",
        "lint": "tsc --project ./src/frontend/tsconfig.json --noEmit && biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@navikt/aksel-icons": "8.21.0",
        "@navikt/ds-css": "8.21.0",
        "@navikt/ds-react": "8.21.0",
        "@navikt/nav-dekoratoren-moduler": "4.6.0",
        "date-fns": "4.4.0",
        "express": "5.3.0",
        "http-proxy-middleware": "4.2.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "uuid": "14.0.3",
        "winston": "3.19.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.6",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "esbuild": "0.28.2",
        "typescript": "5.9.3",
        "vite": "8.3.5"
    }
}
