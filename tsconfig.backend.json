    "skipLibCheck": true,
    "module": "nodenext",
    "outDir": "./build",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "lib": ["esnext", "dom"]
  },
  "include": ["./src/backend"],
  "exclude": ["./src/frontend"]
}
